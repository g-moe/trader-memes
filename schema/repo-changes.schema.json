{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Repository Changes",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "updated", "entries"],
	"properties": {
		"$schema": {
			"type": "string",
			"format": "uri-reference"
		},
		"version": {
			"type": "integer",
			"minimum": 1
		},
		"updated": {
			"type": "string",
			"format": "date"
		},
		"entries": {
			"type": "object",
			"propertyNames": {
				"minLength": 1
			},
			"additionalProperties": {
				"type": "array",
				"minItems": 1,
				"uniqueItems": true,
				"items": {
					"type": "string",
					"minLength": 5
				}
			}
		}
	}
}
