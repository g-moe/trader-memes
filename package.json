{
	"name": "trader-memes",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"setup": "./setup.sh",
		"dev": "pnpm --recursive --parallel --if-present run dev",
		"build": "pnpm --recursive run build",
		"typecheck": "pnpm --recursive run typecheck",
		"test": "pnpm --recursive run test",
		"coverage": "pnpm --recursive run coverage",
		"test:e2e": "playwright test --pass-with-no-tests",
		"test:e2e:install": "playwright install chromium",
		"test:integration": "pnpm --recursive --if-present run test:integration",
		"knip": "knip",
		"lint": "oxlint --type-aware --type-check .",
		"lint:fix": "oxlint --fix --type-aware --type-check .",
		"loc": "cloc --vcs=git",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "pnpm run validate:repo && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run knip",
		"validate": "pnpm run check && pnpm run coverage && pnpm run build",
		"validate:repo": "node ./scripts/validate-repo.mjs"
	},
	"dependencies": {
		"@js-temporal/polyfill": "0.5.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@types/node": "24.12.4",
		"@vitest/coverage-v8": "4.1.10",
		"cloc": "2.6.0-cloc",
		"husky": "9.1.7",
		"jsdom": "29.1.1",
		"knip": "6.26.0",
		"oxfmt": "0.58.0",
		"oxlint": "1.73.0",
		"oxlint-tsgolint": "0.24.0",
		"tsx": "4.23.0",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"packageManager": "pnpm@11.5.2"
}
